{
  "expo": {
    "name": "HabitTrack",
    "slug": "HabitTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omale.habittrack",
      "buildNumber": "com.omale.habittrack"
    },
    "android": {
      "package": "com.omale.habittrack",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "backgroundColor": "#E6F4FE",
          "resizeMode": "cover"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9341de9b-8ed0-4bd3-9346-457dd113f60a"
      }
    }
  }
}
